{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chefmeemz",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "tabletribu.com", "custom_domain": true }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "chefmeemz" }],
  "env": {
    "dev": {
      "name": "chefmeemz-dev",
      "routes": [{ "pattern": "dev.tabletribu.com", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "chefmeemz-dev" }]
    }
  }
}
